rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Recepti: svako može da čita, niko ne piše preko klijenta —
    // pisanje ide samo preko Admin SDK-a (migracioni skript, Cloudflare Worker),
    // koji zaobilazi ova pravila.
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }

    // Ocene recepata: web app piše direktno sa klijenta (nema login-a u appu),
    // pa je pisanje javno ali usko ograničeno — samo polje `rating` (1-5),
    // samo za recipeId koji stvarno postoji u `recipes`. Najgori slučaj zloupotrebe
    // je da neko izvana promeni ocene na nasumične validne vrednosti; ne može da
    // briše/menja recepte niti da piše proizvoljne podatke.
    match /ratings/{recipeId} {
      allow read: if true;
      allow create, update: if exists(/databases/$(database)/documents/recipes/$(recipeId))
                    && request.resource.data.keys().hasOnly(['rating', 'updatedAt'])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow delete: if true;
    }
  }
}
