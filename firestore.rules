rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Recepti: svako može da čita, niko ne piše preko klijenta —
    // pisanje ide samo preko Admin SDK-a (migracioni skript, Cloudflare Worker),
    // koji zaobilazi ova pravila.
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
